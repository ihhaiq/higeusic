API_ID= # get this value from my.telegram.org
API_HASH= # get this value from my.telegram.org
BOT_TOKEN= # get this value from @Botfather
OWNER_ID= # get owner id
MONGO_DB_URI= # optional; falls back to JSON when empty/unavailable
JSON_DB_PATH=data/database.json # use a Railway Volume path for persistence
LOG_GROUP_ID= # get this value from in your log group 
MUSIC_BOT_NAME= # your music bot name 
STRING_SESSION= # pyrogram string session
COOKIES= # raw Netscape cookies.txt content
YOUTUBE_POT_ENABLED=true # automatic local PO Token provider (recommended)
YOUTUBE_POT_PROVIDER_URL=http://127.0.0.1:4416
YOUTUBE_EXTRACT_TIMEOUT=45 # seconds per yt-dlp attempt
LONG_VIDEO_THRESHOLD_MIN=30 # lower video quality after this duration
LONG_VIDEO_MAX_QUALITY=480 # 360, 480, 720, or 1080
