API_ID= # get this value from my.telegram.org
API_HASH= # get this value from my.telegram.org
BOT_TOKEN= # get this value from @Botfather
OWNER_ID= # get owner id
MONGO_DB_URI= # optional; falls back to JSON when empty/unavailable
JSON_DB_PATH=data/database.json # use a Railway Volume path for persistence
LOG_GROUP_ID= # get this value from in your log group 
MUSIC_BOT_NAME= # your music bot name 
STRING_SESSION= # pyrogram string session
COOKIES= # optional; only needed for private, age-restricted, or account-only videos
YOUTUBE_POT_ENABLED=true # automatic local PO Token provider (recommended)
YOUTUBE_POT_PROVIDER_URL=http://127.0.0.1:4416
YOUTUBE_PLAYER_CLIENTS=mweb,web_safari,tv,web # mweb PO Token first, then public anonymous fallbacks
YOUTUBE_AUTO_UPDATE_TOOLS=true # update yt-dlp at startup; failure is non-fatal
YOUTUBE_COOKIES_FILE=cookies/cookies.txt # mounted/persistent cookies.txt path
YOUTUBE_EXTRACT_TIMEOUT=45 # seconds per yt-dlp attempt
TELEGRAM_MEDIA_FALLBACK_ENABLED=false # enable B2B in BotFather for both bots first
TELEGRAM_MEDIA_FALLBACK_CHAT_ID= # group where the music bot asks the external downloader bot
TELEGRAM_MEDIA_FALLBACK_BOT= # external bot username without @
TELEGRAM_MEDIA_FALLBACK_AUDIO_COMMAND=/d # request the video as a document for audio playback
TELEGRAM_MEDIA_FALLBACK_VIDEO_COMMAND=/v # request the video as a Telegram video
TELEGRAM_MEDIA_FALLBACK_RESPONSE_TIMEOUT=180 # seconds to wait for the bot reply
TELEGRAM_MEDIA_FALLBACK_DOWNLOAD_TIMEOUT=900 # seconds allowed to download the returned media
TELEGRAM_MEDIA_FALLBACK_CLEANUP=true # delete request/result messages when permitted
TELEGRAM_MEDIA_FALLBACK_RETRIES=3 # retry the third-party downloader up to 3 times
TELEGRAM_MEDIA_FALLBACK_RETRY_DELAY=3 # seconds between third-party retries
LONG_VIDEO_THRESHOLD_MIN=30 # segmented fallback starts after this duration
LONG_VIDEO_MAX_QUALITY=360 # 360 is recommended for smoother Railway playback
LONG_VIDEO_SEGMENT_MIN=8 # minutes per downloaded playback segment
LONG_VIDEO_DOWNLOAD_CONCURRENCY=1 # one heavy long-video download per Railway instance
LONG_VIDEO_PREFETCH_DELAY_SEC=45 # let playback settle before downloading the next segment
